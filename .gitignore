# ==========================================
# Semana Tecnológica UCPel 2026 — .gitignore
# ==========================================

# Sistemas operacionais
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editores e IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Dependências e ferramentas (caso sejam usadas no futuro)
node_modules/
package-lock.json.bak
.npm/
.cache/

# Builds e saídas temporárias
dist/
build/
.tmp/
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Relatórios de testes e auditorias locais
lighthouse-report*.html
lighthouse-report*.json
playwright-report/
test-results/
coverage/

# Arquivos de design brutos (manter apenas exportações otimizadas em assets/)
*.psd
*.fig
*.xd
*.ai
